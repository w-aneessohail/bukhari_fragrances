{
  "name": "@bukhari/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"dotenv -e ../.env -- tsx src/server.ts\"",
    "start": "dotenv -e ../.env -- node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../.env -- prisma db seed",
    "lint": "echo \"Add eslint config\"",
    "format": "echo \"Add formatter\""
  },
  "dependencies": {
    "@prisma/client": "^5.16.2",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cloudinary": "^2.3.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "stripe": "^16.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "prisma": "^5.16.2",
    "rate-limit-redis": "^4.2.0",
    "winston": "^3.14.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^6.4.16",
    "@types/node": "^20.14.10",
    "dotenv-cli": "^7.4.2",
    "nodemon": "^3.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "dotenv -e ../.env -- tsx prisma/seed.ts"
  }
}
